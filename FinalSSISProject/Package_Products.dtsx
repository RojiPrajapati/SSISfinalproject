                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    s.StgProductID,
    s.ProductID,
    s.ProductName,
    s.Category,
    s.Price,
    s.SourceFileName,
    ROW_NUMBER() OVER (PARTITION BY s.ProductID ORDER BY s.StgProductID) AS RowNum,
    CASE WHEN dp.ProductID IS NOT NULL THEN 1 ELSE 0 END AS AlreadyLoaded
FROM stg.Product s
LEFT JOIN dbo.DimProduct dp ON dp.ProductID = s.ProductID;</property>
