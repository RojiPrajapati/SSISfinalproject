              SQLTask:SqlStatementSource="UPDATE dbo.AuditLog&#xA;SET EndTime = GETDATE(),&#xA;    Status = 'Success',&#xA;    RecordsRead = ?,&#xA;    RecordsInserted = ?,&#xA;    RecordsRejected = ?&#xA;WHERE AuditID = ?;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
