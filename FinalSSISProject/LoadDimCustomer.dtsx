    <DTS:Executable
      DTS:refId="Package\Validate and move"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:Disabled="True"
      DTS:DTSID="{0D7771C0-A459-4396-8D62-2BCB459D7F4D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Validate and move"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="2">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{090CCE35-59F4-4BB4-BF53-877395246AC6}"
          SQLTask:SqlStatementSource="-- Valid rows to DimCustomer&#xA;INSERT INTO dbo.DimCustomer (CustomerID, CustomerName, Email, City, State)&#xA;SELECT DISTINCT s.CustomerID, s.CustomerName, s.Email, s.City, s.State&#xA;FROM stg.Customer s&#xA;WHERE s.CustomerID IS NOT NULL AND TRIM(s.CustomerID) &lt;&gt; ''&#xA;  AND s.CustomerName IS NOT NULL AND TRIM(s.CustomerName) &lt;&gt; ''&#xA;  AND s.Email LIKE '%_@__%.__%'&#xA;  AND NOT EXISTS (SELECT 1 FROM dbo.DimCustomer d WHERE d.CustomerID = s.CustomerID);&#xA;&#xA;-- Rejects&#xA;INSERT INTO dbo.RejectedRecords (SourceFile, RecordKey, ErrorReason, RawData)&#xA;SELECT s.SourceFileName, s.CustomerID,&#xA;    CASE&#xA;        WHEN s.CustomerID IS NULL OR TRIM(s.CustomerID) = '' THEN 'Missing CustomerID'&#xA;        WHEN s.CustomerName IS NULL OR TRIM(s.CustomerName) = '' THEN 'Missing CustomerName'&#xA;        WHEN s.Email NOT LIKE '%_@__%.__%' THEN 'Invalid Email'&#xA;        ELSE 'Other'&#xA;    END,&#xA;    CONCAT('CustomerID=', s.CustomerID, ';Name=', s.CustomerName, ';Email=', s.Email)&#xA;FROM stg.Customer s&#xA;WHERE s.CustomerID IS NULL OR TRIM(s.CustomerID) = ''&#xA;   OR s.CustomerName IS NULL OR TRIM(s.CustomerName) = ''&#xA;   OR s.Email NOT LIKE '%_@__%.__%';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\validationn"
