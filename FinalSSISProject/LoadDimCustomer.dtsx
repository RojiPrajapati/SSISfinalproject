                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset">[stg].[Sales]</property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    s.StgSalesID,
    CAST(s.SaleID AS VARCHAR(50)) AS SaleID,
    CAST(s.SaleDate AS VARCHAR(50)) AS SaleDate,
    TRY_CONVERT(DATE, s.SaleDate, 120) AS SaleDateConverted,
    CAST(s.CustomerID AS VARCHAR(50)) AS CustomerID,
    CAST(s.ProductID AS VARCHAR(50)) AS ProductID,
    CAST(s.StoreID AS VARCHAR(50)) AS StoreID,
    CAST(s.Quantity AS VARCHAR(50)) AS Quantity,
    CAST(s.UnitPrice AS VARCHAR(50)) AS UnitPrice,
    s.SourceFileName,
    ROW_NUMBER() OVER (PARTITION BY s.SaleID ORDER BY s.StgSalesID) AS RowNum,
    CASE WHEN fs.SaleID IS NOT NULL THEN 1 ELSE 0 END AS AlreadyLoaded
FROM stg.Sales s
LEFT JOIN dbo.FactSales fs ON fs.SaleID = s.SaleID;</property>
