                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    s.StgCustomerID,
    s.CustomerID,
    s.CustomerName,
    s.Email,
    s.City,
    s.State,
    s.SourceFileName,
    ROW_NUMBER() OVER (PARTITION BY s.CustomerID ORDER BY s.StgCustomerID) AS RowNum,
    CASE WHEN dc.CustomerID IS NOT NULL THEN 1 ELSE 0 END AS AlreadyLoaded
FROM stg.Customer s
LEFT JOIN dbo.DimCustomer dc ON dc.CustomerID = s.CustomerID;</property>
